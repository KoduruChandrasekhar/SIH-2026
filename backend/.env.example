# TraceNet backend settings. Copy to backend/.env (git-ignored) and adjust.

# PostgreSQL + PostGIS (docker compose up -d postgis)
TRACENET_DB_HOST=localhost
TRACENET_DB_PORT=5432
TRACENET_DB_NAME=tracenet
TRACENET_DB_USER=tracenet
TRACENET_DB_PASSWORD=tracenet

# Optional full DSN (overrides the fields above)
# TRACENET_DATABASE_URL=postgresql://tracenet:tracenet@localhost:5432/tracenet
# Hosted (Supabase session pooler, used on Render). URL-encode special characters in the password.
# TRACENET_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Phase 6: JWT signing secret (the API warns and uses a development secret when unset) and token lifetime
TRACENET_JWT_SECRET=change-me-to-a-long-random-string
# TRACENET_JWT_TTL=28800

# Live pipeline (all optional - see backend/fusion/runtime.py)
# TRACENET_FUSION_TRANSPORT=auto        # auto | broker | direct
# TRACENET_FUSION_WORKER=embedded       # embedded | external (python -m backend.fusion.worker)
# TRACENET_REDIS_URL=redis://localhost:6379/0
# TRACENET_AMQP_URL=amqp://guest:guest@localhost:5672/%2F
# TRACENET_INGEST_SOURCE=rtsp           # read cameras from MediaMTX instead of the MP4 files
# TRACENET_RTSP_BASE=rtsp://localhost:8554
# TRACENET_HLS_BASE=http://localhost:8888      # MediaMTX HLS, shown on the Cameras page when live
# TRACENET_WEBRTC_BASE=http://localhost:8889
# TRACENET_INGESTION_AUTOSTART=0              # 1: start camera ingestion with the API (needs the full ML stack)
# TRACENET_ANALYTICS_INTERVAL=45              # seconds between Polars analytics runs (0 disables)

# Deployed frontend origins allowed by CORS (comma-separated; local dev origins are always allowed)
# TRACENET_CORS_ORIGINS=https://tracenet.vercel.app
# TRACENET_CORS_ORIGIN_REGEX=https://tracenet-.*\.vercel\.app
