# =========================================================
# TraceNet backend generated output
# =========================================================

backend/output/*.mp4
backend/output/*.json

# Phase 2 ANPR results + evidence crops (regenerated by the pipeline)
backend/output/anpr/

# Phase 3 fusion store, sighting dumps and scenario DB (regenerated)
backend/output/fusion/

# Synthetic multi-camera dataset + evaluation (backend/scripts/generate_dataset.py / evaluate_dataset.py)
backend/output/dataset/

# MediaMTX stream files (backend/scripts/prepare_streams.py)
backend/output/streams/

# Keep the output directory itself
!backend/output/.gitkeep

# =========================================================
# Generated annotated camera videos
# These are generated locally and MUST NOT be pushed.
# =========================================================

public/camera-feeds/*_annotated.mp4

