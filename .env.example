# TraceNet frontend (Vite) settings. Values are baked in at build time.
#   Local:  copy to .env.local (git-ignored) and adjust.
#   Vercel: Project → Settings → Environment Variables, then redeploy.

# Backend origin, e.g. https://api.your-domain.com (must be https when the site is https).
# Leave empty on Vercel to deploy the self-contained demo: bundled dataset, no API calls.
# In `npm run dev` an empty value falls back to http://localhost:8000.
VITE_API_BASE_URL=

# Sign in automatically as the demo officer (default true). Set to false to require the Login page.
VITE_DEMO_AUTO_LOGIN=true

# Real-time traffic on the Traffic map (TomTom Traffic Flow tiles, like Google Maps' traffic layer).
# Free key: https://developer.tomtom.com — restrict it to your site's domain in the TomTom dashboard,
# since any key in a frontend build is visible to visitors.
VITE_TOMTOM_API_KEY=

# Google Maps live traffic on the Traffic page (Google's own traffic layer — takes priority over TomTom).
# Google Cloud Console → enable "Maps JavaScript API" → create an API key (needs a billing account;
# the monthly free credit covers light use). Restrict it to your domain (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=
