# TraceNet frontend (Vite) settings. Values are baked in at build time.
#   Local:  copy to .env.local (git-ignored) and adjust.
#   Vercel: Project → Settings → Environment Variables, then redeploy.

# Backend origin, e.g. https://api.your-domain.com (must be https when the site is https).
# Leave empty on Vercel to deploy the self-contained demo: bundled dataset, no API calls.
# In `npm run dev` an empty value falls back to http://localhost:8000.
VITE_API_BASE_URL=

# Sign in automatically as the demo officer (default true). Set to false to require the Login page.
VITE_DEMO_AUTO_LOGIN=true
